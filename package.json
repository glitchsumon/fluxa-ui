{
  "name": "fluxa-ui",
  "version": "1.0.0",
  "description": "Fluxa UI — a modern, original, accessible component framework with Structured Motion design language.",
  "type": "module",
  "main": "./dist/fluxa.umd.cjs",
  "module": "./dist/fluxa.js",
  "style": "./dist/fluxa-ui.css",
  "exports": {
    ".": {
      "import": "./dist/fluxa.js",
      "require": "./dist/fluxa.umd.cjs"
    },
    "./dist/fluxa-ui.css": "./dist/fluxa-ui.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "css",
    "framework",
    "ui",
    "components",
    "design-system",
    "accessible",
    "vanilla"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.docs.config.js",
    "build": "vite build",
    "docs": "npm run build && vite build --config vite.docs.config.js",
    "docs:dev": "vite --config vite.docs.config.js",
    "preview": "vite preview --config vite.docs.config.js",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "lint": "eslint src tests --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}